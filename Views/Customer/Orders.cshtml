@{
    ViewData["Title"] = "Orders";
}
@model List<cafe.Models.Order>
@{
    ViewData["Title"] = "My Orders";

}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="h3 mb-3 fw-bold text-primary">
                <i class="fas fa-list me-2"></i>My Orders
            </h2>
            <p class="text-muted">Track all your past and current orders</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-clipboard-list fa-5x text-muted mb-4"></i>
            <h4 class="text-muted mb-3">No orders yet</h4>
            <p class="text-muted mb-4">Start ordering from our delicious menu!</p>
            <a href="/Customer/Menu" class="btn btn-primary btn-lg">
                <i class="fas fa-utensils me-2"></i>Order Now
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var order in Model)
            {
                <div class="col-lg-6 col-xl-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-light border-0 pb-0 position-relative">
                            <h6 class="mb-1 fw-bold">#@order.OrderId</h6>
                            <small class="text-muted">@order.OrderTime.ToString("MMM dd, yyyy hh:mm tt")</small>
                            <span class="badge position-absolute top-0 end-0 m-2 
                                @(order.OrderStatus == "Completed" ? "bg-success" :
                                  order.OrderStatus == "Ready" ? "bg-info" :
                                  order.OrderStatus == "Preparing" ? "bg-warning" : "bg-secondary")">
                                @order.OrderStatus
                            </span>
                        </div>
                        <div class="card-body py-4">
                            <div class="mb-3">
                                @if (order.Table != null)
                                {
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fas fa-table me-2 text-primary"></i>
                                        <span class="fw-bold">Table @order.Table.TableNumber</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-outline-primary">Takeaway</span>
                                }
                            </div>

                            @if (order.OrderItems != null && order.OrderItems.Any())
                            {
                                <div class="mb-3">
                                    <h6 class="fw-bold mb-2">Items:</h6>
                                    <div class="row g-2">
                                        @foreach (var item in order.OrderItems.Take(3))
                                        {
                                            <div class="col-12">
                                                <div class="d-flex justify-content-between small">
                                                    <span>@item.MenuItem?.ItemName</span>
                                                    <span>@item.Quantity × ₹@item.Price = ₹@item.Subtotal</span>
                                                </div>
                                            </div>
                                        }
                                        @if (order.OrderItems.Count > 3)
                                        {
                                            <div class="col-12">
                                                <small class="text-muted">+@(order.OrderItems.Count - 3) more items</small>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <span class="h6 fw-bold text-primary">₹@order.TotalAmount</span>
                                @if (order.OrderStatus == "Pending" || order.OrderStatus == "Preparing")
                                {
                                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                                        <span class="visually-hidden">Processing...</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>