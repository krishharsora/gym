@model cafe.Models.DebugViewModel
@{
    ViewData["Title"] = "🛠️ DEBUG - Cart & Order";
}

<div class="container py-5">
    <h1>🛠️ DEBUG: Cart & Order Status</h1>
    <p><small class="text-muted">Customer ID: <strong>@Model.CustomerId</strong> | 
        <a href="/Customer/Cart">Cart</a> | 
        <a href="/Customer/Orders">Orders</a></small></p>
    
    <div class="row g-4">
        <!-- Customer & Session -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h6>👤 Customer & Session</h6>
                </div>
                <div class="card-body">
                    <p><strong>Customer ID:</strong> @Model.CustomerId</p>
                    <p><strong>Cart Key:</strong> <code>@Model.CartKey</code></p>
                    <p><strong>Session Keys:</strong> @Model.AllSessionKeys.Count total</p>
                    @if (!string.IsNullOrEmpty(Model.CartJson))
                    {
                        <p><span class="badge bg-success">✅ Cart JSON: @Model.CartJson.Length chars</span></p>
                    }
                    else
                    {
                        <p><span class="badge bg-danger">❌ NO CART JSON!</span></p>
                    }
                </div>
            </div>
        </div>

        <!-- Cart Items -->
        <div class="col-md-6">
            <div class="card @(Model.CartItems.Any() ? "border-success" : "border-warning")">
                <div class="card-header @(Model.CartItems.Any() ? "bg-success text-white" : "bg-warning text-dark")">
                    <h6>🛒 Cart Items: <strong>@Model.CartItems.Count</strong></h6>
                </div>
                <div class="card-body">
                    @if (Model.CartItems.Any())
                    {
                        <ul class="list-unstyled">
                            @foreach (var item in Model.CartItems)
                            {
                                <li class="mb-2 p-2 bg-light rounded">
                                    Item <strong>@item.ItemId</strong>: <strong>@item.Quantity</strong>x
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted">
                            <i class="fas fa-shopping-cart fa-2x mb-2"></i><br/>
                            Cart is empty
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h6>📋 Recent Orders (@Model.RecentOrders.Count)</h6>
                </div>
                <div class="card-body">
                    @if (Model.RecentOrders.Any())
                    {
                        @foreach (var order in Model.RecentOrders)
                        {
                            <div class="alert alert-success">
                                <strong>#@order.OrderId</strong> | 
                                @order.OrderStatus | 
                                ₹@order.TotalAmount | 
                                @order.OrderTime
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info">No orders found</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Stripe Session -->
    @if (!string.IsNullOrEmpty(Model.SessionId) && Model.StripeSession != null)
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-primary">
                    <div class="card-header bg-primary text-white">
                        <h6>💳 Stripe Session: <code>@Model.SessionId</code></h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Status:</strong> <span class="badge @(Model.StripeSession.PaymentStatus == "paid" ? "bg-success" : "bg-warning")">@Model.StripeSession.PaymentStatus</span></p>
                                <p><strong>Amount:</strong> ₹@(Model.StripeSession.AmountTotal / 100.0m)</p>
                            </div>
                            <div class="col-md-6">
                                <details>
                                    <summary>Metadata</summary>
                                    <pre class="small bg-light p-2 rounded">@(Model.StripeSession.Metadata != null ? System.Text.Json.JsonSerializer.Serialize(Model.StripeSession.Metadata) : "null")</pre>
                                </details>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger mt-4">
            <i class="fas fa-bug me-2"></i><strong>ERROR:</strong> @Model.Error
        </div>
    }
</div>

<style>
pre { font-size: 0.8em; max-height: 200px; overflow-y: auto; }
code { background: #f8f9fa; padding: 2px 4px; border-radius: 3px; }
</style>