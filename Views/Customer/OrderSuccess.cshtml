@model dynamic
@{
    ViewData["Title"] = "Order Success!";
    var sessionId = Context.Request.Query["session_id"].ToString();
    var customerIdParam = Context.Request.Query["customerId"].ToString();
    var error = ViewBag.Error as string;
    var orderCreated = ViewBag.OrderCreated == true;
    var totalAmount = ViewBag.TotalAmount as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
            @if (ViewBag.Success == true)
            {
                <div class="alert alert-success">
                    <h2>✅ Order Confirmed!</h2>
                    @if (ViewBag.OrderId != null)
                    {
                        <p><strong>Order ID:</strong> @ViewBag.OrderId</p>
                        <p><strong>Total:</strong> ₹@ViewBag.TotalAmount</p>
                        <p><strong>Items:</strong> @ViewBag.ItemCount</p>
                    }
                    else
                    {
                        <p>Your order has been placed successfully!</p>
                    }
                </div>
            }
            else if (!string.IsNullOrEmpty(ViewBag.Error as string))
            {
                <div class="alert alert-danger">
                    <h2>❌ @ViewBag.Error</h2>
                    <p><a href="/Customer/DebugOrderStatus?session_id=@ViewBag.SessionId">Debug Info</a></p>
                </div>
            }
            else
            {
                <i class="fas fa-clock fa-5x text-warning mb-4"></i>
                <h1 class="display-4 fw-bold text-warning mb-4">Processing...</h1>
                <p class="lead mb-5">Your payment was received. Order is being processed.</p>
            }

            <div class="d-grid gap-3 col-lg-6 mx-auto">
                <a href="/Customer/Orders" class="btn btn-success btn-lg">
                    <i class="fas fa-list me-2"></i>View My Orders
                </a>
                <a href="/Customer/Menu" class="btn btn-outline-primary btn-lg">
                    <i class="fas fa-utensils me-2"></i>Order More
                </a>
                <a href="/Customer/Dashboard" class="btn btn-outline-secondary btn-lg">
                    <i class="fas fa-home me-2"></i>Dashboard
                </a>
            </div>
        </div>
    </div>
</div>