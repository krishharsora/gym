@{
    ViewData["Title"] = "Register";
}
@{
ViewData["Title"] = "Register";
Layout = null;
}

<!DOCTYPE html>

<html>
<head>

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Register - cafe System</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>

body{
height:100vh;
display:flex;
align-items:center;
justify-content:center;
background:url('/images/p2.jpg');
background-size:cover;
background-position:center;
font-family:'Poppins',sans-serif;
}


/* Glass Card */

.register-card{

width:100%;
max-width:420px;

background:rgba(255,255,255,0.15);

backdrop-filter:blur(12px);

border:1px solid rgba(255,255,255,0.3);

border-radius:15px;

box-shadow:0 10px 30px rgba(0,0,0,0.3);

padding:30px;

color:rgb(0, 0, 0);

}


/* Title */

.register-title{
text-align:center;
font-weight:600;
margin-bottom:20px;
}


/* Input */

.form-control{
background:rgba(255,255,255,0.2);
border:none;
color:rgb(173, 158, 158);
}

.form-control::placeholder{
color:#020202;
}

.form-control:focus{
background:rgba(255,255,255,0.3);
box-shadow:none;
}


/* Button */

.btn-register{
background:#27ae60;
border:none;
font-weight:500;
}

.btn-register:hover{
background:#1e8449;
}


/* Links */

.register-links a{
color:white;
text-decoration:none;
font-size:14px;
}

.register-links a:hover{
text-decoration:underline;
}

</style>

</head>

<body>

<div class="register-card">

<div class="register-title">

<h4>CafeXpert System</h4>
<p>Create Account</p>

</div>

<form method="post">

<input class="form-control mb-3" name="name" placeholder="Full Name" required>

<input class="form-control mb-3" name="email" placeholder="Email Address" required>

<input class="form-control mb-3" type="password" name="password" placeholder="Password" minlength="6" required>

<input class="form-control mb-3" type="tel" name="phone" placeholder="Phone Number" maxlength="10" required>

<button class="btn btn-register w-100">
Send OTP
</button>

</form>

<hr style="border-color:rgba(255,255,255,0.4)">

<div class="text-center register-links">

<a href="/Account/Login" class="text-black">Already have an account? Login</a>

</div>

</div>

</body>
</html>
