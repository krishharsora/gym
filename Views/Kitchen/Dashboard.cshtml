@{
    ViewData["Title"] = "Dashboard";
}
@model DashboardViewModel
@{

    ViewData["Title"] = "Dashboard";
}
 <style>
        :root {
            --primary: #28a745;
            --secondary: #6c757d;
            --danger: #dc3545;
            --warning: #ffc107;
            --info: #17a2b8;
            --success: #20c997;
        }
        body { font-family: 'Poppins', sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; }
        .sidebar { background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); box-shadow: 0 8px 32px rgba(0,0,0,0.1); }
        .navbar-brand { font-weight: 700; color: var(--primary) !important; }
        .nav-link { color: #495057 !important; font-weight: 500; transition: all 0.3s; }
        .nav-link:hover, .nav-link.active { color: var(--primary) !important; background: rgba(40,167,69,0.1); border-radius: 10px; }
        .stat-card { border: none; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); transition: transform 0.3s; }
        .stat-card:hover { transform: translateY(-5px); }
        .status-badge { font-size: 0.85em; padding: 0.5em 1em; border-radius: 25px; font-weight: 600; }
        .status-pending { background: linear-gradient(45deg, #ffc107, #ffed4e); color: #856404; }
        .status-preparing { background: linear-gradient(45deg, #17a2b8, #4bc0d9); color: white; }
        .status-ready { background: linear-gradient(45deg, var(--primary), #20c997); color: white; }
        .btn-modern { border-radius: 25px; font-weight: 600; padding: 0.75em 2em; transition: all 0.3s; }
        .order-card { border-left: 5px solid var(--primary); transition: all 0.3s; }
        .order-card:hover { box-shadow: 0 10px 25px rgba(0,0,0,0.15); transform: translateY(-2px); }
    </style>
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold text-white mb-1">
                <i class="fas fa-tachometer-alt me-3"></i>Kitchen Dashboard
            </h1>
            <p class="text-white-50 mb-0">Real-time kitchen operations overview</p>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-5">
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card text-white bg-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-1">@Model.Stats.PendingCount</h2>
                            <p class="mb-0">New Orders</p>
                        </div>
                        <i class="fas fa-clock fs-1 opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card text-white bg-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-1">@Model.Stats.PreparingCount</h2>
                            <p class="mb-0">Preparing</p>
                        </div>
                        <i class="fas fa-fire fs-1 opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card text-white" style="background: linear-gradient(135deg, var(--primary), #20c997);">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-1">@Model.Stats.ReadyCount</h2>
                            <p class="mb-0">Ready Orders</p>
                        </div>
                        <i class="fas fa-check-circle fs-1 opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card text-white bg-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-1">@Model.Stats.TotalToday</h2>
                            <p class="mb-0">Orders Today</p>
                        </div>
                        <i class="fas fa-calendar-day fs-1 opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h4 class="card-title mb-0">
                        <i class="fas fa-list me-2 text-primary"></i>Recent Orders
                    </h4>
                </div>
                <div class="card-body pt-0">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Order #</th>
                                    <th>Customer</th>
                                    <th>Table</th>
                                    <th>Status</th>
                                    <th>Amount</th>
                                    <th>Time</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <tr class="order-card">
                                        <td><span class="badge bg-primary">#@order.OrderId</span></td>
                                        <td>@order.CustomerName</td>
                                        <td>Table @order.TableNumber</td>
                                        <td>
                                            <span class="status-badge status-@(order.OrderStatus.ToLower())">@order.OrderStatus</span>
                                        </td>
                                        <td>₹@order.TotalAmount?.ToString("F2")</td>
                                        <td>@order.OrderTime.ToString("hh:mm tt")</td>
                                        <td>
                                            <a href="/Kitchen/OrderDetails/@order.OrderId" class="btn btn-sm btn-outline-primary btn-modern">
                                                <i class="fas fa-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>