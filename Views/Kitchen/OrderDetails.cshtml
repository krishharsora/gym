@{
    ViewData["Title"] = "OrderDetails";
}
@model OrderDetailsViewModel
@{
   
    ViewData["Title"] = $"Order #{Model.OrderId}";
}
 <style>
        :root {
            --primary: #28a745;
            --secondary: #6c757d;
            --danger: #dc3545;
            --warning: #ffc107;
            --info: #17a2b8;
            --success: #20c997;
        }
        body { font-family: 'Poppins', sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; }
        .sidebar { background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); box-shadow: 0 8px 32px rgba(0,0,0,0.1); }
        .navbar-brand { font-weight: 700; color: var(--primary) !important; }
        .nav-link { color: #495057 !important; font-weight: 500; transition: all 0.3s; }
        .nav-link:hover, .nav-link.active { color: var(--primary) !important; background: rgba(40,167,69,0.1); border-radius: 10px; }
        .stat-card { border: none; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); transition: transform 0.3s; }
        .stat-card:hover { transform: translateY(-5px); }
        .status-badge { font-size: 0.85em; padding: 0.5em 1em; border-radius: 25px; font-weight: 600; }
        .status-pending { background: linear-gradient(45deg, #ffc107, #ffed4e); color: #856404; }
        .status-preparing { background: linear-gradient(45deg, #17a2b8, #4bc0d9); color: white; }
        .status-ready { background: linear-gradient(45deg, var(--primary), #20c997); color: white; }
        .btn-modern { border-radius: 25px; font-weight: 600; padding: 0.75em 2em; transition: all 0.3s; }
        .order-card { border-left: 5px solid var(--primary); transition: all 0.3s; }
        .order-card:hover { box-shadow: 0 10px 25px rgba(0,0,0,0.15); transform: translateY(-2px); }
    </style>
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-5 fw-bold text-white mb-0">
                    <i class="fas fa-receipt me-3"></i>Order #@Model.OrderId
                </h1>
                <span class="status-badge status-@(Model.OrderStatus.ToLower()) fs-5 px-4 py-2">@Model.OrderStatus</span>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Order Info Card -->
        <div class="col-lg-4">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-header bg-transparent">
                    <h5 class="card-title mb-0"><i class="fas fa-info-circle me-2 text-primary"></i>Order Info</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-4"><strong>Customer:</strong></div>
                        <div class="col-8">@Model.CustomerName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-4"><strong>Table:</strong></div>
                        <div class="col-8">Table @Model.TableNumber</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-4"><strong>Time:</strong></div>
                        <div class="col-8">@Model.OrderTime.ToString("dd/MM/yyyy hh:mm tt")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-4"><strong>Total:</strong></div>
                        <div class="col-8 h5 text-success fw-bold">₹@Model.TotalAmount?.ToString("F2")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Items List Card -->
                <!-- Items List Card -->
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-header bg-transparent">
                    <h5 class="card-title mb-0"><i class="fas fa-utensils me-2 text-success"></i>Order Items</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Qty</th>
                                    <th>Price</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.ItemName</strong>
                                            @if (!string.IsNullOrEmpty(item.Description))
                                            {
                                                <br /><small class="text-muted">@item.Description</small>
                                            }
                                        </td>
                                        <td><span class="badge bg-light text-dark">@item.Quantity</span></td>
                                        <td>₹@item.Price.ToString("F2")</td>
                                        <td class="fw-bold text-success">₹@(item.Quantity * item.Price).ToString("F2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-lg border-0">
                <div class="card-body text-center py-4">
                    @{
                        var currentStatus = Model.OrderStatus;
                        var nextStatus = currentStatus == "Pending" ? "Preparing" :
                                       currentStatus == "Preparing" ? "Ready" : "Completed";
                        var buttonText = currentStatus == "Pending" ? "Start Preparing" :
                                       currentStatus == "Preparing" ? "Mark as Ready" : "Complete Order";
                        var buttonIcon = currentStatus == "Pending" ? "fas fa-fire" :
                                       currentStatus == "Preparing" ? "fas fa-check-circle" : "fas fa-check-double";
                        var buttonColor = currentStatus == "Pending" ? "btn-warning" :
                                        currentStatus == "Preparing" ? "btn-success" : "btn-primary";
                    }
                    
                    <form asp-action="UpdateStatus" method="post" style="display: inline-block;">
                        <input type="hidden" name="orderId" value="@Model.OrderId" />
                        <input type="hidden" name="newStatus" value="@nextStatus" />
                        <button type="submit" class="btn @buttonColor btn-modern btn-lg px-5 me-3">
                            <i class="@buttonIcon me-3"></i>@buttonText
                        </button>
                    </form>
                    
                    <a href="/Kitchen/@(currentStatus == "Pending" ? "NewOrders" : 
                          currentStatus == "Preparing" ? "Preparing" : 
                          currentStatus == "Ready" ? "Ready" : "Completed")" 
                       class="btn btn-outline-secondary btn-modern btn-lg px-5">
                        <i class="fas fa-arrow-left me-3"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>