@{
    ViewData["Title"] = "NewOrders";
}
@model List<OrderViewModel>
@{
   
    ViewData["Title"] = "New Orders";
}
 <style>
        :root {
            --primary: #28a745;
            --secondary: #6c757d;
            --danger: #dc3545;
            --warning: #ffc107;
            --info: #17a2b8;
            --success: #20c997;
        }
        body { font-family: 'Poppins', sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; }
        .sidebar { background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); box-shadow: 0 8px 32px rgba(0,0,0,0.1); }
        .navbar-brand { font-weight: 700; color: var(--primary) !important; }
        .nav-link { color: #495057 !important; font-weight: 500; transition: all 0.3s; }
        .nav-link:hover, .nav-link.active { color: var(--primary) !important; background: rgba(40,167,69,0.1); border-radius: 10px; }
        .stat-card { border: none; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); transition: transform 0.3s; }
        .stat-card:hover { transform: translateY(-5px); }
        .status-badge { font-size: 0.85em; padding: 0.5em 1em; border-radius: 25px; font-weight: 600; }
        .status-pending { background: linear-gradient(45deg, #ffc107, #ffed4e); color: #856404; }
        .status-preparing { background: linear-gradient(45deg, #17a2b8, #4bc0d9); color: white; }
        .status-ready { background: linear-gradient(45deg, var(--primary), #20c997); color: white; }
        .btn-modern { border-radius: 25px; font-weight: 600; padding: 0.75em 2em; transition: all 0.3s; }
        .order-card { border-left: 5px solid var(--primary); transition: all 0.3s; }
        .order-card:hover { box-shadow: 0 10px 25px rgba(0,0,0,0.15); transform: translateY(-2px); }
    </style>
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold text-white mb-1">
                <i class="fas fa-clock me-3"></i>New Orders (@Model.Count)
            </h1>
            <p class="text-white-50 mb-0">Pending orders waiting for kitchen action</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-clipboard-list fa-5x text-white-50 mb-4"></i>
            <h3 class="text-white">No new orders</h3>
            <p class="text-white-50">All caught up! Great job 👏</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var order in Model)
            {
                <div class="col-xl-4 col-lg-6">
                    <div class="card order-card h-100 shadow-lg border-0">
                        <div class="card-header bg-transparent pb-0">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="card-title mb-1">#@order.OrderId</h5>
                                    <small class="text-muted">@order.CustomerName</small>
                                </div>
                                <span class="badge bg-warning status-badge status-pending">PENDING</span>
                            </div>
                        </div>
                        <div class="card-body pt-2">
                            <div class="mb-3">
                                <small class="text-muted"><i class="fas fa-table me-1"></i>Table @order.TableNumber</small>
                            </div>
                            <div class="mb-3">
                                <small class="text-muted"><i class="fas fa-utensils me-1"></i>@order.Items</small>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="h6 mb-0 fw-bold">₹@order.TotalAmount?.ToString("F2")</span>
                                <span class="badge bg-light text-dark px-3 py-2">@order.OrderTime.ToString("hh:mm tt")</span>
                            </div>
                            <form asp-action="UpdateStatus" method="post" style="display: inline;">
                                <input type="hidden" name="orderId" value="@order.OrderId" />
                                <input type="hidden" name="newStatus" value="Preparing" />
                                <button type="submit" class="btn btn-success btn-modern w-100">
                                    <i class="fas fa-fire me-2"></i>Start Preparing
                                </button>
                            </form>
                            <a href="/Kitchen/OrderDetails/@order.OrderId" class="btn btn-outline-primary btn-modern w-100 mt-2">
                                <i class="fas fa-eye me-2"></i>View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>