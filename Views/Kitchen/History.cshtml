@{
    ViewData["Title"] = "History";
}
@model PagedOrderViewModel
@{

    ViewData["Title"] = "Order History";
}
 <style>
        :root {
            --primary: #28a745;
            --secondary: #6c757d;
            --danger: #dc3545;
            --warning: #ffc107;
            --info: #17a2b8;
            --success: #20c997;
        }
        body { font-family: 'Poppins', sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; }
        .sidebar { background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); box-shadow: 0 8px 32px rgba(0,0,0,0.1); }
        .navbar-brand { font-weight: 700; color: var(--primary) !important; }
        .nav-link { color: #495057 !important; font-weight: 500; transition: all 0.3s; }
        .nav-link:hover, .nav-link.active { color: var(--primary) !important; background: rgba(40,167,69,0.1); border-radius: 10px; }
        .stat-card { border: none; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); transition: transform 0.3s; }
        .stat-card:hover { transform: translateY(-5px); }
        .status-badge { font-size: 0.85em; padding: 0.5em 1em; border-radius: 25px; font-weight: 600; }
        .status-pending { background: linear-gradient(45deg, #ffc107, #ffed4e); color: #856404; }
        .status-preparing { background: linear-gradient(45deg, #17a2b8, #4bc0d9); color: white; }
        .status-ready { background: linear-gradient(45deg, var(--primary), #20c997); color: white; }
        .btn-modern { border-radius: 25px; font-weight: 600; padding: 0.75em 2em; transition: all 0.3s; }
        .order-card { border-left: 5px solid var(--primary); transition: all 0.3s; }
        .order-card:hover { box-shadow: 0 10px 25px rgba(0,0,0,0.15); transform: translateY(-2px); }
    </style>
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold text-white mb-1">
                <i class="fas fa-history me-3"></i>Order History
            </h1>
            <p class="text-white-50 mb-0">Completed orders archive (@Model.TotalCount total)</p>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>#</th>
                                    <th>Customer</th>
                                    <th>Table</th>
                                    <th>Items</th>
                                    <th>Amount</th>
                                    <th>Completed</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.Orders)
                                {
                                    <tr class="order-card">
                                        <td><span class="badge bg-secondary fs-6">#@order.OrderId</span></td>
                                        <td>@order.CustomerName</td>
                                        <td>Table @order.TableNumber</td>
                                        <td>
                                            <small class="text-muted">@order.Items</small>
                                        </td>
                                        <td><strong>₹@order.TotalAmount?.ToString("F2")</strong></td>
                                        <td>@order.OrderTime.ToString("dd/MM hh:mm")</td>
                                        <td>
                                            <a href="/Kitchen/OrderDetails/@order.OrderId" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Order history pagination">
                            <ul class="pagination justify-content-center mt-4">
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="/Kitchen/History?page=@(Model.CurrentPage-1)">Previous</a>
                                </li>
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="/Kitchen/History?page=@i">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="/Kitchen/History?page=@(Model.CurrentPage+1)">Next</a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div>