
@model Order
@{
    ViewData["Title"] = "Generate Bill";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Generate Bill - Order #@Model.OrderId</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --success-gradient: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            --cash-gradient: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
            --upi-gradient: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
            --total-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--primary-gradient);
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }

        .bill-container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .bill-card {
            background: rgba(255,255,255,0.95);
            border-radius: 25px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.15);
            overflow: hidden;
            backdrop-filter: blur(10px);
        }

        .bill-header {
            background: var(--primary-gradient);
            color: white;
            padding: 40px;
            text-align: center;
        }

        .bill-header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .bill-body {
            padding: 40px;
        }

        .info-card {
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            border-radius: 20px;
        }

        .item-row {
            border-bottom: 1px solid #eee;
            padding: 20px 0;
            transition: all 0.3s ease;
        }

        .item-row:hover {
            background: #f8f9ff;
            border-radius: 15px;
            margin: 0 -20px;
            padding: 20px;
            transform: translateY(-2px);
        }

        .total-section {
            background: var(--total-gradient);
            color: white;
            padding: 40px;
            border-radius: 25px;
            margin-top: 30px;
            text-align: center;
        }

        .grand-total {
            font-size: 4rem;
            font-weight: 800;
            text-shadow: 3px 3px 6px rgba(0,0,0,0.3);
            margin-bottom: 10px;
        }

        .payment-btn {
            padding: 20px 60px;
            border-radius: 50px;
            font-size: 1.4rem;
            font-weight: 700;
            border: none;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            margin: 0 20px;
            min-width: 250px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        }

        .btn-cash {
            background: var(--cash-gradient);
            color: #d63384;
        }

        .btn-upi {
            background: var(--upi-gradient);
            color: #0d6efd;
        }

        .payment-btn:hover:not(:disabled) {
            transform: translateY(-8px) scale(1.05);
            box-shadow: 0 25px 50px rgba(0,0,0,0.3);
        }

        .payment-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        .loading {
            display: none;
            text-align: center;
            padding: 50px;
        }

        .spinner {
            border: 5px solid #f3f3f3;
            border-top: 5px solid #667eea;
            border-radius: 50%;
            width: 70px;
            height: 70px;
            animation: spin 1s linear infinite;
            margin: 0 auto 25px;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .custom-alert {
            position: fixed;
            top: 30px;
            right: 30px;
            z-index: 99999;
            min-width: 400px;
            max-width: 500px;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            animation: slideInRight 0.4s ease-out;
        }

        @@keyframes slideInRight {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        @@media (max-width: 768px) {
            .payment-btn { 
                display: block; 
                margin: 15px auto; 
                min-width: 280px; 
            }
        }
    </style>
</head>
<body>
    <div class="bill-container">
        <!-- Success/Error Alerts -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show custom-alert">
                <i class="fas fa-check-circle fa-2x me-3"></i>
                <strong>Success!</strong> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show custom-alert">
                <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
                <strong>Error!</strong> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Main Bill Card -->
        <div class="bill-card">
            <!-- Header -->
            <div class="bill-header">
                <h1 class="mb-4">
                    <i class="fas fa-receipt fa-3x me-4"></i>
                    <span>FINAL BILL</span>
                </h1>
                <div class="mb-3">
                    <span class="badge bg-light text-dark fs-4 px-5 py-3">Order #@Model.OrderId</span>
                </div>
                <small class="opacity-75">Ready for payment processing</small>
            </div>
            
            <!-- Body -->
            <div class="bill-body">
                <!-- Customer & Order Info -->
                <div class="row mb-5 g-4">
                    <div class="col-md-6">
                        <div class="card info-card p-4 h-100">
                            <h5 class="text-primary mb-4">
                                <i class="fas fa-user-circle me-2"></i>
                                Customer Information
                            </h5>
                            <div class="row">
                                <div class="col-4"><strong>Name:</strong></div>
                                <div class="col-8">@(Model.Customer?.Name ?? "Walk-in Customer")</div>
                            </div>
                            <div class="row">
                                <div class="col-4"><strong>Phone:</strong></div>
                                <div class="col-8">@(Model.Customer?.Phone ?? "N/A")</div>
                            </div>
                            <div class="row">
                                <div class="col-4"><strong>Table:</strong></div>
                                <div class="col-8">Table @(Model.Table?.TableNumber)</div>
                            </div>
                            <div class="row">
                                <div class="col-4"><strong>Time:</strong></div>
                                <div class="col-8">@Model.OrderTime.ToString("dd/MM/yyyy hh:mm tt")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card info-card p-4 h-100 text-center">
                            <h5 class="text-success mb-4">
                                <i class="fas fa-clock me-2"></i>
                                Order Status
                            </h5>
                            <div class="display-5 fw-bold text-success mb-3">@Model.OrderStatus</div>
                            <div class="badge bg-success fs-5 px-4 py-2 w-100">
                                @Model.OrderItems?.Count() items
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Items Table -->
                <div class="mb-5">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th width="55%">Item Details</th>
                                    <th class="text-end" width="12%">Qty</th>
                                    <th class="text-end" width="15%">Rate</th>
                                    <th class="text-end" width="18%">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems ?? new List<OrderItem>())
                                {
                                    <tr class="item-row">
                                        <td>
                                            <div class="fw-bold">@(item.MenuItem?.ItemName ?? "N/A")</div>
                                            @if (!string.IsNullOrEmpty(item.MenuItem?.Description))
                                            {
                                                <small class="text-muted d-block">@item.MenuItem.Description</small>
                                            }
                                        </td>
                                        <td class="text-end fs-5 fw-bold text-primary">@item.Quantity</td>
                                        <td class="text-end fw-semibold">₹@(item.Price?.ToString("F2") ?? "0.00")</td>
                                        <td class="text-end fs-5 fw-bold text-success">₹@(item.Subtotal?.ToString("F2") ?? "0.00")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr class="fw-bold fs-5">
                                    <th colspan="3" class="text-end">GRAND TOTAL</th>
                                    <th class="text-end text-success h4">
                                        ₹@(Model.TotalAmount?.ToString("F2") ?? "0.00")
                                    </th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Grand Total Card -->
                <div class="total-section">
                    <div class="row align-items-center">
                        <div class="col-lg-5">
                            <h3 class="mb-3">Grand Total</h3>
                            <p class="lead mb-0 opacity-90">Inclusive of all taxes</p>
                        </div>
                        <div class="col-lg-7">
                            <div class="grand-total">₹@(Model.TotalAmount?.ToString("F2") ?? "0.00")</div>
                        </div>
                    </div>
                </div>

                <!-- Payment Action -->
                <div class="text-center mt-5 pt-5 border-top">
                    <h4 class="mb-5 text-primary">Select Payment Method</h4>
                    
                    <!-- Anti-forgery token -->
                    @Html.AntiForgeryToken()
                    
                    <!-- Loading -->
                    <div class="loading" id="loadingSpinner">
                        <div class="spinner"></div>
                        <p class="mt-4 text-primary fs-5">Generating bill receipt...</p>
                    </div>

                    <!-- Buttons -->
                    <div id="paymentButtons">
                        <button type="button" class="payment-btn btn-cash" onclick="generateBill('Cash')">
                            <i class="fas fa-money-bill-wave fa-2x d-block mb-3"></i>
                            <span class="d-block fs-4">CASH</span>
                            <small class="opacity-75">Press C key</small>
                        </button>
                        
                        <button type="button" class="payment-btn btn-upi" onclick="generateBill('UPI')">
                            <i class="fas fa-mobile-alt fa-2x d-block mb-3"></i>
                            <span class="d-block fs-4">UPI/CARD</span>
                            <small class="opacity-75">Press U key</small>
                        </button>
                    </div>

                    <!-- Navigation -->
                    <div class="mt-5 pt-4">
                        <div class="d-flex flex-column flex-md-row gap-3 justify-content-center">
                            <a href="/Cashier/BillsPending" class="btn btn-outline-secondary btn-lg px-5">
                                <i class="fas fa-arrow-left me-2"></i>Pending Bills
                            </a>
                            <a href="/Cashier/Dashboard" class="btn btn-outline-primary btn-lg px-5">
                                <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
    $(document).ready(function() {
        console.log('✅ Bill page loaded - Order #@Model.OrderId');
        console.log('Total: ₹@Model.TotalAmount');
        
        // Keyboard shortcuts
        $(document).on('keydown', function(e) {
            if (e.which === 67) { // C key
                e.preventDefault();
                generateBill('Cash');
            }
            if (e.which === 85) { // U key  
                e.preventDefault();
                generateBill('UPI');
            }
        });
    });

    // 🔥 Generate Bill AJAX
    async function generateBill(paymentMethod) {
        const orderId = @Model.OrderId;
        const $btns = $('#paymentButtons button');
        const $loading = $('#loadingSpinner');
        
        console.log(`🚀 Bill: ${orderId}, Method: ${paymentMethod}`);
        
        // UI states
        $btns.prop('disabled', true);
        $loading.show();
        
        try {
            const response = await fetch('/Cashier/GenerateBill', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify(orderId)
            });
            
            const result = await response.json();
            console.log('📥 Response:', result);
            
            if (result.success) {
                showToast('success', `Bill generated!<br><strong>ID: ${result.paymentId}</strong>`);
                setTimeout(() => window.location.href = '/Cashier/Payments', 2500);
            } else {
                                showToast('error', result.message || 'Failed to generate bill');
            }
        } catch (error) {
            console.error('❌ Error:', error);
            showToast('error', 'Connection error. Please try again.');
        } finally {
            $btns.prop('disabled', false);
            $loading.hide();
        }
    }

    // 🔔 Beautiful toast notifications
    function showToast(type, message) {
        // Remove existing
        $('.toast-alert').remove();
        
        const icons = {
            success: 'check-circle text-success',
            error: 'exclamation-triangle text-danger'
        };
        
        const $toast = $(`
            <div class="alert alert-${type} alert-dismissible fade show position-fixed toast-alert custom-alert" 
                 style="top: 30px; right: 30px; z-index: 99999; min-width: 420px; border-radius: 20px; box-shadow: 0 20px 40px rgba(0,0,0,0.25);">
                <div class="d-flex align-items-center">
                    <i class="fas fa-${icons[type] || 'info-circle'} fa-2x me-3 flex-shrink-0"></i>
                    <div class="flex-grow-1">
                        <strong>${type === 'success' ? 'Success!' : 'Error!'}</strong>
                        <div class="mt-1">${message}</div>
                    </div>
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert"></button>
                </div>
            </div>
        `);
        
        $('body').append($toast);
        
        // Auto hide
        setTimeout(() => {
            $toast[0].classList.remove('show');
            setTimeout(() => $toast.remove(), 400);
        }, 5000);
    }
    </script>
</body>
</html>