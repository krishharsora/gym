@{
    ViewData["Title"] = "Dashboard";
}
@model dynamic
@{
    ViewData["Title"] = "Cashier Dashboard";
}

<div class="cashier-container">
    <style>
        .cashier-container { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh; padding: 20px; 
        }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin: 20px 0; }
        .stat-card { 
            background: rgba(255,255,255,0.95); border-radius: 20px; padding: 30px; 
            box-shadow: 0 20px 40px rgba(0,0,0,0.1); transition: transform 0.3s ease;
            text-align: center; position: relative; overflow: hidden;
        }
        .stat-card:hover { transform: translateY(-10px); }
        .stat-icon { font-size: 3rem; margin-bottom: 15px; }
        .stat-number { font-size: 2.5rem; font-weight: bold; color: #667eea; }
        .stat-label { color: #666; font-size: 1.1rem; margin-top: 5px; }
        .recent-activity { background: white; border-radius: 15px; padding: 25px; margin-top: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
        .activity-item { padding: 15px; border-left: 4px solid #667eea; margin-bottom: 15px; background: #f8f9ff; border-radius: 10px; }
    </style>

    <div class="container-fluid">
        <h1 class="text-white mb-4"><i class="fas fa-cash-register me-3"></i>Cashier Dashboard</h1>
        
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon text-warning">📋</div>
                <div class="stat-number">@(((dynamic)ViewBag.Stats).PendingBills)</div>
                <div class="stat-label">Pending Bills</div>
                <a href="/Cashier/PendingBills" class="btn btn-outline-primary mt-3">View All</a>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon text-success">💰</div>
                <div class="stat-number">₹@(((dynamic)ViewBag.Stats).TodaySales?.ToString("F2") ?? "0.00")</div>
                <div class="stat-label">Today's Sales</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon text-info">🏠</div>
                <div class="stat-number">@(((dynamic)ViewBag.Stats).TotalTables)</div>
                <div class="stat-label">Total Tables</div>
            </div>
        </div>

        <div class="recent-activity">
            <h3>Quick Actions</h3>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <a href="/Cashier/BillsPending" class="btn btn-primary w-100 h-100 p-4 text-center" style="border-radius: 15px; font-size: 1.2rem;">
                        <i class="fas fa-list mb-2 d-block"></i>Pending Bills
                    </a>
                </div>
                <div class="col-md-3 mb-3">
                    <a href="/Cashier/Payments" class="btn btn-success w-100 h-100 p-4 text-center" style="border-radius: 15px; font-size: 1.2rem;">
                        <i class="fas fa-credit-card mb-2 d-block"></i>Process Payments
                    </a>
                </div>
                <div class="col-md-3 mb-3">
                    <a href="/Cashier/CompletedPayments" class="btn btn-info w-100 h-100 p-4 text-center" style="border-radius: 15px; font-size: 1.2rem;">
                        <i class="fas fa-check-circle mb-2 d-block"></i>Completed
                    </a>
                </div>
                <div class="col-md-3 mb-3">
                    <a href="/Cashier/DailySales" class="btn btn-warning w-100 h-100 p-4 text-center" style="border-radius: 15px; font-size: 1.2rem;">
                        <i class="fas fa-chart-line mb-2 d-block"></i>Daily Sales
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

