@{
    ViewData["Title"] = "Table List";
}
@model List<cafe.Models.CafeTable>

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white py-4">
                    <div class="row align-items-center">
                        <div class="col">
                            <h2 class="mb-0">
                                <i class="fas fa-table me-2"></i>
                                Cafe Tables Management
                            </h2>
                        </div>
                        <div class="col-auto">
                            <a asp-action="CreateTable" class="btn btn-light btn-lg shadow-sm">
                                <i class="fas fa-plus me-2"></i>Add New Table
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-flush align-middle mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th class="px-4 py-3">
                                        <span class="fw-bold text-muted text-uppercase text-xs">ID</span>
                                    </th>
                                    <th class="px-4 py-3">
                                        <span class="fw-bold text-muted text-uppercase text-xs">Table Number</span>
                                    </th>
                                    <th class="px-4 py-3">
                                        <span class="fw-bold text-muted text-uppercase text-xs">Capacity</span>
                                    </th>
                                    <th class="px-4 py-3">
                                        <span class="fw-bold text-muted text-uppercase text-xs">QR Code</span>
                                    </th>
                                    <th class="px-4 py-3">
                                        <span class="fw-bold text-muted text-uppercase text-xs">Status</span>
                                    </th>
                                    <th class="px-4 py-3 text-center">
                                        <span class="fw-bold text-muted text-uppercase text-xs">Actions</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="list">
                                @foreach (var table in Model)
                                {
                                    <tr class="hover-shadow">
                                        <td class="px-4 py-3">
                                            <span class="fw-bold text-primary">#@table.TableId</span>
                                        </td>
                                        <td class="px-4 py-3">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-shape avatar-sm me-3 bg-gradient-info">
                                                    <i class="fas fa-chair text-white opacity-8"></i>
                                                </div>
                                                <div>
                                                    <p class="mb-0 text-sm font-weight-bold">@table.TableNumber</p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <span class="badge badge-lg @(table.Capacity >= 6 ? "bg-success" : "bg-warning")">
                                                @table.Capacity seats
                                            </span>
                                        </td>
                                        <td class="px-4 py-3">
                                            @if (!string.IsNullOrEmpty(table.QrCodeUrl))
                                            {
                                                <a href="@table.QrCodeUrl" target="_blank" class="btn btn-sm btn-outline-success" 
                                                   data-bs-toggle="tooltip" title="View QR Code">
                                                    <i class="fas fa-qrcode me-1"></i>View
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">No QR Code</span>
                                            }
                                        </td>
                                        <td class="px-4 py-3">
                                            <span class="badge badge-lg @(table.Status == "Available" ? "bg-success" : 
                                                (table.Status == "Reserved" ? "bg-warning" : "bg-danger"))">
                                                @table.Status
                                            </span>
                                        </td>
                                        <td class="px-4 py-3 text-center">
                                            <div class="btn-group" role="group">
                                                <a asp-action="EditTable" asp-route-id="@table.TableId" 
                                                   class="btn btn-sm btn-outline-primary btn-icon-only hover-lift" 
                                                   data-bs-toggle="tooltip" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <form asp-action="DeleteTable" asp-route-id="@table.TableId" 
                                                      method="post" class="d-inline delete-form" 
                                                      onsubmit="return confirm('Are you sure you want to delete Table #@table.TableNumber?')">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger btn-icon-only hover-lift" 
                                                            data-bs-toggle="tooltip" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Custom Styles (Updated) -->
<style>
    .bg-gradient-primary {
        background: linear-gradient(87deg, #5e72e4 0, #825ee4 100%) !important;
    }
    
    .table-flush thead th {
        border-top: 0;
    }
    
    .table-hover tbody tr:hover {
        background-color: rgba(0,0,0,.025);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(0,0,0,.1);
    }
    
    .hover-shadow:hover {
        box-shadow: 0 4px 12px rgba(0,0,0,.15) !important;
        transform: translateY(-2px);
        transition: all 0.2s ease-in-out;
    }
    
    .btn-icon-only {
        width: 38px;
        height: 38px;
        padding: 0;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    
    .avatar-shape {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .hover-lift:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(0,0,0,.2) !important;
    }
</style>

<!-- Font Awesome & Bootstrap -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
</script>