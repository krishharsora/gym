@{
    ViewData["Title"] = "Reservations";
}
@model List<cafe.Models.Reservation>
@using cafe.Models
@{
    ViewData["Title"] = "Reservations Management";
    var customers = ViewBag.Customers as List<Customer>;
    var tables = ViewBag.Tables as List<CafeTable>;
}

<div class="container-fluid py-5 min-vh-100" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden" style="background: rgba(255,255,255,0.95); backdrop-filter: blur(20px);">
                <!-- Header -->
                <div class="card-header bg-transparent border-0 p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="fw-bold mb-2">
                                <i class="fas fa-calendar-check text-primary me-3"></i>
                                Reservations Management
                            </h1>
                            <p class="text-muted mb-0 fs-6">Manage table bookings • <strong>@ViewBag.TotalReservations</strong> active reservations</p>
                        </div>
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
                                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Create Form -->
                    <div class="row g-4 mb-5">
                        <div class="col-lg-8">
                            <div class="card border-0 shadow-sm rounded-3 h-100">
                                <div class="card-body p-4">
                                    <h5 class="card-title mb-4 fw-semibold">
                                        <i class="fas fa-plus-circle text-primary me-2"></i>New Reservation
                                    </h5>
                                    <form asp-action="CreateReservation" method="post" asp-controller="Admin">
                                        @Html.AntiForgeryToken()
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Customer</label>
                                                <select asp-for="FirstOrDefault().CustomerId" name="CustomerId" class="form-select rounded-3" required>
                                                    <option value="">Select Customer</option>
                                                    @foreach (var customer in customers)
                                                    {
                                                        <option value="@customer.CustomerId">@customer.Name ( @customer.Phone )</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Table</label>
                                                <select asp-for="FirstOrDefault().TableId" name="TableId" class="form-select rounded-3" required>
                                                    <option value="">Select Table</option>
                                                    @foreach (var table in tables)
                                                    {
                                                        <option value="@table.TableId">Table @table.TableNumber (@table.Capacity seats)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold">Date</label>
                                                <input asp-for="FirstOrDefault().ReservationDate" name="ReservationDate" type="date" class="form-control rounded-3" required />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold">Time</label>
                                                <input asp-for="FirstOrDefault().ReservationTime" name="ReservationTime" type="time" class="form-control rounded-3" required />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold">Guests</label>
                                                <input asp-for="FirstOrDefault().GuestCount" name="GuestCount" type="number" min="1" max="20" class="form-control rounded-3" required />
                                            </div>
                                            <div class="col-12">
                                                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 fw-semibold">
                                                    <i class="fas fa-calendar-plus me-2"></i>Create Reservation
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card border-0 shadow-sm rounded-3 h-100" style="position: sticky; top: 20px;">
                                <div class="card-body p-4">
                                    <h6 class="card-title mb-3 fw-semibold">
                                        <i class="fas fa-table me-2 text-primary"></i>Available Tables
                                    </h6>
                                    <div class="list-group list-group-flush">
                                        @foreach (var table in tables)
                                        {
                                            <div class="list-group-item px-0 py-3 border-0">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <strong>Table @table.TableNumber</strong>
                                                        <div class="text-muted small">@table.Capacity seats</div>
                                                    </div>
                                                    <span class="badge bg-success rounded-pill px-3 py-2">@table.Status</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Reservations Table -->
                    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                        <div class="card-header bg-light border-0 p-4">
                            <h5 class="mb-0 fw-semibold">All Reservations</h5>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Customer</th>
                                        <th>Table</th>
                                        <th>Date & Time</th>
                                        <th>Guests</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var reservation in Model)
                                    {
                                        <tr class="align-middle">
                                            <td><strong>#@reservation.ReservationId</strong></td>
                                            <td>
                                                <div>@reservation.Customer.Name</div>
                                                <small class="text-muted">@reservation.Customer.Phone</small>
                                            </td>
                                            <td>
                                                <span class="fw-semibold">Table @reservation.Table.TableNumber</span>
                                                <div class="badge bg-light text-dark fs-6">@reservation.Table.Capacity seats</div>
                                            </td>
                                            <td>
    @{
        string dateDisplay = "N/A";
        string timeDisplay = "N/A";
        
        if (reservation.ReservationDate.HasValue)
        {
            dateDisplay = reservation.ReservationDate.Value.ToString("MMM dd, yyyy");
        }
        
        if (reservation.ReservationTime.HasValue)
        {
            timeDisplay = reservation.ReservationTime.Value.ToString(@"hh\:mm tt");
        }
    }
    <div class="fw-semibold">@dateDisplay</div>
    <small class="text-muted">@timeDisplay</small>
</td>
                                            <td>
                                                <i class="fas fa-user-friends text-primary me-1"></i>
                                                @reservation.GuestCount
                                            </td>
                                            <td>
                                                <span class="badge px-3 py-2 fw-semibold rounded-pill
                                                    @(reservation.Status == "Confirmed" ? "bg-success text-white" :
                                                      reservation.Status == "Cancelled" ? "bg-danger text-white" :
                                                      "bg-warning text-dark")">
                                                    @reservation.Status
                                                </span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    @if (reservation.Status == "Pending")
                                                    {
                                                        <form asp-action="UpdateStatus" asp-route-reservationId="@reservation.ReservationId" asp-route-status="Confirmed" method="post" style="display:inline;">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-success btn-sm rounded-2" title="Confirm">
                                                                <i class="fas fa-check"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (reservation.Status != "Cancelled")
                                                    {
                                                        <form asp-action="CancelReservation" asp-route-reservationId="@reservation.ReservationId" method="post" style="display:inline;" 
                                                              onsubmit="return confirm('Cancel this reservation?')">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger btn-sm rounded-2" title="Cancel">
                                                                <i class="fas fa-times"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto-hide alerts
        setTimeout(() => {
            document.querySelectorAll('.alert').forEach(alert => {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}