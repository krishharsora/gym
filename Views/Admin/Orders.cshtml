@{
    ViewData["Title"] = "Orders";
}
@model List<cafe.Models.Order>

<h2>Orders</h2>

<table class="table table-bordered">

<thead>
<tr>
<th>Order ID</th>
<th>Customer</th>
<th>Total Amount</th>
<th>Status</th>
<th>Date</th>
</tr>
</thead>

<tbody>

@foreach(var order in Model)
{
<tr>
<td>@order.OrderId</td>
<td>@order.CustomerId</td>
<td>@order.TotalAmount</td>
<td>@order.OrderStatus</td>
<td>@order.OrderTime</td>
</tr>
}

</tbody>

</table>