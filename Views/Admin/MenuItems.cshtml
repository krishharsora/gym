@model List<cafe.Models.MenuItem>
@{
    ViewData["Title"] = "Menu Items";
  
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="h3 mb-0 fw-bold text-dark">
                <i class="fas fa-utensils me-2 text-success"></i>Menu Items
            </h1>
            <p class="text-muted mb-0">Manage your restaurant menu</p>
        </div>
        <div class="col-auto">
            <a asp-action="AddMenuItem" class="btn btn-success btn-lg shadow-sm">
                <i class="fas fa-plus me-2"></i>Add Menu Item
            </a>
        </div>
    </div>

    

    <!-- Quick Links -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Categories" class="btn btn-outline-info btn-sm">
                    <i class="fas fa-tags me-1"></i>Manage Categories
                </a>
            </div>
        </div>
    </div>

    <!-- Items Grid -->
    @if (Model.Any())
    {
        <div class="row g-4" id="menuItemsGrid">
            @foreach (var item in Model)
            {
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                    <div class="card h-100 border-0 shadow-sm hover-lift rounded-3 overflow-hidden">
                        <!-- Image -->
                        <div class="position-relative overflow-hidden">
                            @{
                                var imageUrl = !string.IsNullOrEmpty(item.ImageUrl) && !item.ImageUrl.StartsWith("http")
                                    ? Url.Content(item.ImageUrl)
                                    : "/images/placeholder-menu.jpg";
                            }
                            <img src="@imageUrl" class="card-img-top" alt="@item.ItemName"
                                 style="height: 160px; width: 100%; object-fit: cover;"
                                 onerror="this.src='/images/placeholder-menu.jpg'">
                            
                            <!-- Status Badge -->
                            <div class="position-absolute top-2 end-2 z-3">
                                <span class="badge rounded-pill px-2 py-1 shadow @(item.IsAvailable == true ? "bg-success" : "bg-danger")">
                                    <i class="fas @(item.IsAvailable == true ? "fa-eye" : "fa-eye-slash") me-1"></i>
                                    @(item.IsAvailable == true ? "Live" : "Draft")
                                </span>
                            </div>
                        </div>

                        <!-- Content -->
                        <div class="card-body p-3">
                            <h6 class="card-title fw-bold mb-2 line-clamp-2">@item.ItemName</h6>
                            <div class="mb-2">
                                <span class="badge bg-light text-dark small fw-semibold">
                                    @item.Category?.CategoryName
                                </span>
                            </div>
                            <p class="card-text small text-muted mb-3 line-clamp-2">@item.Description</p>
                            <div class="d-flex justify-content-between align-items-end">
                                <span class="h6 fw-bold text-success mb-0">₹@item.Price</span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="card-footer bg-transparent p-2 border-0">
                            <div class="btn-group w-100" role="group">
                                <a asp-action="EditMenuItem" asp-route-id="@item.ItemId" 
                                   class="btn btn-outline-primary btn-sm" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="DeleteMenuItem" asp-route-id="@item.ItemId" 
                                   class="btn btn-outline-danger btn-sm" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-10">
            <div class="mb-5">
                <i class="fas fa-utensils fa-6x text-muted opacity-50 mb-4"></i>
            </div>
            <h4 class="text-muted mb-4">No menu items yet</h4>
            <p class="text-muted mb-5">Start by adding your first delicious item!</p>
            <a asp-action="AddMenuItem" class="btn btn-success btn-lg px-5">
                <i class="fas fa-plus me-2"></i>Add First Item
            </a>
        </div>
    }
</div>

<style>
.hover-lift {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.hover-lift:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.12) !important;
}
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
</style>

@section Scripts {
<script>
// Quick search/filter
document.addEventListener('DOMContentLoaded', function() {
    // Auto-hide alerts
    setTimeout(() => $('.alert').fadeOut(), 4000);
});
</script>
}