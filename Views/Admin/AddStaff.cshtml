@model cafe.Models.User
@{
    ViewData["Title"] = "AddStaff";
}


<h2>Add Staff</h2>

<form asp-action="AddStaff" method="post">
    <div class="form-group">
        <label>Name</label>
        <input asp-for="FullName" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Email</label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="form-group">
        <label>Phone</label>
        <input asp-for="Phone" class="form-control" />
    </div>

    <div class="form-group">
        <label>Role</label>
        <select asp-for="Role" class="form-control">
            <option>Admin</option>
            <option>Manager</option>
            <option>Kitchen</option>
            <option>Cashier</option>
        </select>
    </div>

    <div class="form-group">
        <label>Password</label>
        <input asp-for="PasswordHash" type="password" class="form-control" required />
    </div>

    <div class="form-check">
        <input type="checkbox" name="Status" value="true"
               @((Model?.Status ?? false) ? "Active" : "Deactive") />
        <label>Status Active</label>
    </div>

    <br />
    <button type="submit" class="btn btn-success">Save</button>
    <a href="/Admin/StaffList" class="btn btn-secondary">Cancel</a>
</form>