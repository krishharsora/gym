@{
    ViewData["Title"] = "DeleteStaff";
}
@{
    ViewData["Title"] = "DeleteConfirmed";
}
@model cafe.Models.User

<h2>Delete Staff</h2>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this staff?</h4>
</div>

<div>
    <p><strong>Name:</strong> @Model.FullName</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Role:</strong> @Model.Role</p>
</div>

<form method="post">
    <input type="hidden" asp-for="UserId" />

    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a href="/Admin/StaffList" class="btn btn-secondary">Cancel</a>
</form>