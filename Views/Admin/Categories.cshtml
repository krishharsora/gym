@model List<CategoryViewModel>
@{
    ViewData["Title"] = "Categories";
   
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="h3 mb-0 fw-bold text-dark">
                <i class="fas fa-tags me-2 text-info"></i>Menu Categories
            </h1>
            <p class="text-muted mb-0">Manage food and drink categories</p>
        </div>
        <div class="col-auto">
            <a asp-action="AddCategory" class="btn btn-primary btn-lg shadow-sm">
                <i class="fas fa-plus me-2"></i>Add Category
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

   
    <!-- Categories Table -->
    <div class="card shadow-lg border-0 rounded-3 overflow-hidden">
        <div class="card-header bg-white border-0 py-3">
            <h6 class="mb-0 fw-bold text-muted">
                <i class="fas fa-list me-2 text-info"></i>All Categories (@Model.Count())
            </h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light sticky-top">
                    <tr>
                        <th style="width: 250px;">Name</th>
                        <th style="width: 300px;">Description</th>
                      
                        <th style="width: 100px;">Items</th>
                       
                        <th style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model.OrderBy(c => c.CategoryName))
                    {
                        <tr class="align-middle">
                            <td>
                                <div>
                                    <h6 class="mb-1 fw-bold">@category.CategoryName</h6>
                                    <small class="text-muted">@(category.Description ?? "No description")</small>
                                </div>
                            </td>
                            <td class="small">
                                @category.Description
                            </td>
                            
                            <td>
                                <span class="badge bg-light text-dark">@category.ItemCount</span>
                            </td>
                          
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="EditCategory" asp-route-id="@category.CategoryId" 
                                       class="btn btn-outline-primary rounded-pill px-3" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="DeleteCategory" asp-route-id="@category.CategoryId" 
                                       class="btn btn-outline-danger rounded-pill px-3" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    // Auto-hide alerts
    setTimeout(() => {
        $('.alert').fadeOut('slow');
    }, 5000);
    </script>
}